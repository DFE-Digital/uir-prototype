{% extends "layouts/main.html" %}

{% block pageTitle %}
  What is your request about? – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block containerStart %}
  {{ govukBackLink({
    text: "Back",
    href: "what-you-need"
  }) }}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <form class="form" action="ai" method="post">

        {{ govukRadios({
          name: "request-about",
          value: data['request-about'],
          fieldset: {
            legend: {
              text: "What is your request about?",
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          hint: {
            text: "Choose the option that best describes your request"
          },
          items: [
            {
              value: "report-a-problem",
              text: "Report a problem",
              hint: {
                text: "Something isn't working as expected"
              }
            },
            {
              value: "suggest-a-change",
              text: "Suggest a change",
              hint: {
                text: "An idea to improve a service or process"
              }
            },
            {
              value: "raise-a-risk",
              text: "Raise a risk or compliance concern",
              hint: {
                text: "Report concerns about legal or regulatory requirements"
              }
            },
            {
              divider: "or"
            },
            {
              value: "something-else",
              text: "Something else",
              hint: {
                text: "You're not sure which option to choose"
              }
            }
          ]
        }) }}

        {{ govukButton({
          text: "Continue"
        }) }}

      </form>

    </div>
  </div>

{% endblock %}
